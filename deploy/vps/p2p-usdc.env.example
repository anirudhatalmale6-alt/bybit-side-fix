# Safe parallel USDC contour.
# Use this as overrides for /etc/p2p-bots/p2p-usdc.env on VPS.

P2P_ASSET=USDC
P2P_PLATFORMS=BINANCE,BYBIT

# Start with fiats that are already confirmed on the current Binance account/UI.
P2P_FIATS=PLN,EUR
MARKET_DISCOVERY_FIATS=PLN,EUR

# Keep the new contour simple at first.
ENABLE_CROSS_CURRENCY=false
ENABLE_INTERNAL_GRAPH=true
SCANNER_FETCH_TIMEOUT_SEC=10
INTERNAL_GRAPH_INTERVAL_SEC=180

# Share the same bot token/chat, but do not poll Telegram updates from the second instance.
TELEGRAM_ENABLE_POLLING=false

# Keep the USDC contour alert-only until it proves stable.
ENABLE_ORDER_EXECUTION=false
ENABLE_EXCHANGE_EXECUTION=false
AUTO_MANAGE_BUY_SIDE=false
AUTO_MANAGE_SELL_SIDE=false

# Hard per-fiat price sanity bounds to drop obvious garbage offers before routing.
P2P_PRICE_MIN_BY_FIAT=AED:3.50267,AUD:1.22317,CAD:1.1058,CHF:0.73914,CZK:19.3903,DKK:4.83254,EUR:0.8342,GBP:0.70616,HKD:6.0916,HUF:219.0357,IDR:15890.54,ILS:2.25137,JPY:140.65,NOK:6.8773,PLN:3.50267,QAR:2.8033,RON:3.8509,SAR:3.589,SEK:6.8191,THB:31.04,TRY:43.65,USD:0.776,VND:25111.36,ZAR:15.43561
P2P_PRICE_MAX_BY_FIAT=AED:4.13545,AUD:1.99923,CAD:1.751,CHF:0.9888,CZK:26.3989,DKK:6.43235,EUR:1.08871,GBP:1.01455,HKD:8.8786,HUF:429.48734,IDR:19558.67,ILS:4.3054,JPY:249.03237,NOK:12.1952,PLN:4.89147,QAR:4.017,RON:5.81126,SAR:4.429,SEK:12.0716,THB:43.2188,TRY:57.93647,USD:1.339,VND:28027.33,ZAR:18.7872

# Avoid private Bybit advertiser management on the USDC contour.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Optional: tighten signal floors for a thinner book during the first observation window.
MIN_SPREAD_ALERT_PCT=1.5
MIN_ALERT_PROFIT_USD=50
MIN_ALERT_VOLUME_USDT=300
ROUTE_MIN_AMOUNT_BUFFER_PCT=5
ROUTE_MAX_AMOUNT_HEADROOM_PCT=10
ROUTE_AVAILABLE_HEADROOM_PCT=15
CANDIDATE_BOOK_SCAN_DEPTH=20
CANDIDATE_BOOK_RANK_START=2
CANDIDATE_BOOK_RANK_END=15
